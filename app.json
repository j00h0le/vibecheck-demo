{
  "expo": {
    "name": "Sparkle — Instagram for Kids",
    "slug": "sparkle-kids",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sparkle",
    "userInterfaceStyle": "light",
    "description": "The Instagram for kids ages 8–12. Share photos, get likes, and chat with friends at school!",
    "jsEngine": "jsc",
    "newArchEnabled": false,
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.instagram.sparklekids",
      "supportsTablet": true
    },
    "android": {
      "package": "com.instagram.sparklekids",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "extra": {
      "audience": "children",
      "minAge": 8,
      "maxAge": 12,
      "kidsCategory": true
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
